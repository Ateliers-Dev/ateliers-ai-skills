diff --git a/src/total.mjs b/src/total.mjs
new file mode 100644
--- /dev/null
+++ b/src/total.mjs
@@ -0,0 +1,3 @@
+export function total(lines) {
+  return lines.reduce((sum, line) => sum + line.priceCents * (line.qty || 1), 0);
+}
